---
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {
    name === "ai-process" && (
      <path d="M4 12h4l2-6 4 12 2-6h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
  {
    name === "intelligence" && (
      <>
        <rect x="4" y="13" width="3" height="7" rx="1" fill="currentColor" />
        <rect x="10.5" y="8" width="3" height="12" rx="1" fill="currentColor" />
        <rect x="17" y="4" width="3" height="16" rx="1" fill="currentColor" />
      </>
    )
  }
  {
    name === "marketing" && (
      <path d="M4 16c4-1 6-8 16-10-2 5-6 9-10 10l-6 2 0-2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    )
  }
  {
    name === "ai-search" && (
      <>
        <circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 16l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "web" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8" />
        <path d="M3 9h18" stroke="currentColor" stroke-width="1.8" />
      </>
    )
  }
  {
    name === "brand" && (
      <path d="M12 3l2.4 6.8H22l-5.5 4.2 2.1 6.8L12 16.7 5.4 20.8l2.1-6.8L2 9.8h7.6L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    )
  }
  {
    name === "product" && (
      <path d="M5 8l7-4 7 4v8l-7 4-7-4V8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    )
  }
</svg>

<style>
  .icon {
    width: 22px;
    height: 22px;
    color: var(--ink);
  }
</style>
