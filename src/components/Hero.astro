---
import { services } from "../data/services";
import Glyph from "./Glyph.astro";
---
<section class="hero">
  <div class="wrap">
    <h1>
      Accelerate Your Growth.
      <span>Human Strategy, <em>AI Speed.</em></span>
    </h1>
    <p class="sub">
      We bridge the gap between business vision and automated execution. Human-led
      direction meets AI-driven performance to eliminate operational friction and
      scale smarter.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#capabilities">Explore Capabilities</a>
      <a class="btn btn-secondary" href="#strategy">Book Strategy Session</a>
    </div>
    <ul class="chips" aria-label="Capabilities">
      {
        services.map((service) => (
          <li>
            <a href={`#${service.slug}`}>
              <span class="tile" aria-hidden="true"><Glyph name={service.slug} /></span>
              {service.short}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 28px;
    text-align: center;
  }

  h1 {
    margin: 0 auto;
    max-width: 18ch;
    font-family: var(--serif);
    font-weight: 650;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  h1 span { display: block; }
  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--gem-deep);
  }

  .sub {
    margin: 22px auto 0;
    max-width: 46rem;
    color: var(--ink-soft);
    font-size: 1.125rem;
    line-height: 1.55;
    font-weight: 500;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 56px 0 0;
    padding: 0;
  }

  .chips a {
    width: 104px;
    min-height: 118px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 16px 8px 12px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 10px 30px rgba(13, 50, 68, 0.05);
    text-decoration: none;
    color: var(--ink);
    font: 700 12px/1.2 var(--sans);
  }

  .tile {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background:
      linear-gradient(160deg, var(--cream), #fff 55%, var(--mist));
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .chips li:nth-child(2n) .tile {
    background: linear-gradient(160deg, var(--mist), #fff);
  }

  .chips li:nth-child(3n) .tile {
    background: linear-gradient(160deg, #d4f0ea, #fff);
  }

  @media (max-width: 640px) {
    .hero { padding-top: 36px; }
    .chips a { width: 92px; min-height: 108px; }
  }
</style>
