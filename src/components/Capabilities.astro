---
import { services } from "../data/services";
---
<section class="capabilities" id="capabilities">
  <div class="wrap">
    <p class="eyebrow">Capabilities</p>
    <h2>Human-led direction. Automated execution.</h2>
    <div class="bento">
      {
        services.map((service) => (
          <article class:list={["card", service.size]} id={service.slug}>
            <p class="label">{service.label}</p>
            <h3>{service.headline}</h3>
            <p>{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .capabilities {
    padding: 48px 0 24px;
    scroll-margin-top: 156px;
  }

  .eyebrow {
    margin: 0;
    color: var(--gem-deep);
    font: 800 12px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 10px 0 28px;
    max-width: 16ch;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .card {
    grid-column: span 2;
    min-height: 280px;
    padding: 28px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(13, 50, 68, 0.06);
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 50px rgba(13, 50, 68, 0.12);
  }

  .card.wide { grid-column: span 3; }

  .label {
    margin: 0 0 18px;
    color: var(--gem-deep);
    font: 800 12px/1.3 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.65rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .card > p:last-child {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .card,
    .card.wide { grid-column: span 1; }
  }

  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; }
  }
</style>
