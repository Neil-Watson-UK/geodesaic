---
import type { WorkItem } from "../data/work";
import { base } from "../base";

const { study, reverse = false } = Astro.props as {
  study: WorkItem;
  reverse?: boolean;
};
---
<article class:list={["study", { reverse }]}>
  <div class="wrap split">
    <div class="copy">
      <p class="eyebrow">{study.eyebrow}</p>
      <h2>{study.name}</h2>
      <p class="lede">{study.lede}</p>
      <ul class="frames">
        {study.frames.map((frame) => (
          <li>
            <strong>{frame.label}</strong>
            <span>{frame.title}</span>
          </li>
        ))}
      </ul>
      <div class="actions">
        <a class="btn btn-navy" href={`${base}${study.path.replace(/^\//, "")}`}>Read the case study</a>
        <a class="btn btn-secondary" href={study.url} rel="noreferrer">{study.urlLabel}</a>
      </div>
    </div>

    <aside class="preview" aria-label={`${study.name} snapshot`}>
      <div class="shot">
        <p class="kicker">The challenge</p>
        <h3>{study.previewHeading}</h3>
        <p>{study.challenge.body}</p>
      </div>
      <div class="shot shot-dark">
        <p class="kicker">Live flow</p>
        <ol>
          {study.flow.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>
      <div class="shot">
        <p class="kicker">Stack</p>
        <p class="chips">
          {study.stack.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
    </aside>
  </div>
</article>

<style>
  .study { padding: 40px 0; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .reverse .split { direction: rtl; }
  .reverse .split > * { direction: ltr; }

  .eyebrow {
    margin: 0;
    color: var(--gem-deep);
    font: 800 12px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 10px 0 16px;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lede {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 500;
    max-width: 38rem;
  }

  .frames {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .frames li { display: grid; gap: 4px; }

  .frames strong {
    color: var(--gem-deep);
    font: 800 11px/1.3 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .frames span {
    font-family: var(--serif);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .preview { display: grid; gap: 14px; }

  .shot {
    padding: 22px 24px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(13, 50, 68, 0.06);
    box-shadow: var(--shadow);
  }

  .shot-dark {
    background: var(--ink);
    color: #fff;
    border-color: transparent;
  }

  .kicker {
    margin: 0 0 8px;
    font: 800 11px/1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gem-deep);
  }

  .shot-dark .kicker { color: var(--gem-light); }

  h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.45rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .shot p:last-child {
    margin: 10px 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .shot-dark p:last-child { color: rgba(255,255,255,0.78); }

  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
  }

  ol li {
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(98, 196, 164, 0.24);
    color: #fff;
    font: 700 12px/1 var(--sans);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips span {
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--mist);
    font: 700 12px/1 var(--sans);
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .split,
    .reverse .split {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 28px;
    }
  }
</style>
